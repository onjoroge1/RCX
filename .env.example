# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (pooled endpoint)
DATABASE_URL='postgresql://user:password@host.neon.tech/dbname?sslmode=require'

# openssl rand -base64 32
AUTH_SECRET=''

# openssl rand -hex 32  — encrypts integration credentials and provider/webhook secrets
ENCRYPTION_KEY=''

# openssl rand -hex 32 — bearer secret for POST /api/internal/messaging/run
RCX_WORKER_SECRET=''

AUTH_URL='http://localhost:3000'

# Google RBM and SMS provider credentials are tenant/environment data, encrypted in
# provider_accounts. Do not put service-account JSON or Twilio auth tokens in env.

# Set to any truthy value to force the data layer to throw, for demoing error states (spec §27)
DEMO_FORCE_ERROR=''

# Demo workspace sign-in. Powers the one-click "Explore the demo workspace" button,
# and is what db/seed/auth.ts provisions. Omit both to disable demo access entirely.
DEMO_USER_EMAIL='demo@rcx.example'
DEMO_USER_PASSWORD=''

# RCX platform-admin bootstrap. /admin/login uses the fixed username `admin`.
# The backing database email is internal-only and defaults to admin@rcx.local.
# PLATFORM_ADMIN_PASSWORD is never committed; set it securely, then run
# `pnpm db:seed:admin` to create/rekey the platform-admin identity.
PLATFORM_ADMIN_EMAIL='admin@rcx.local'
PLATFORM_ADMIN_PASSWORD=''
PLATFORM_ADMIN_NAME='RCX Platform Admin'