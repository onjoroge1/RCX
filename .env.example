# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (pooled endpoint)
DATABASE_URL='postgresql://user:password@host.neon.tech/dbname?sslmode=require'

# openssl rand -base64 32
AUTH_SECRET=''

# openssl rand -hex 32  — encrypts integration credentials and provider/webhook secrets
ENCRYPTION_KEY=''

# openssl rand -hex 32 — bearer secret for protected internal worker endpoints
RCX_WORKER_SECRET=''

# openssl rand -hex 32 — Vercel automatically sends this as the Bearer token
# for the one-minute /api/cron/workers recovery sweep.
CRON_SECRET=''

AUTH_URL='http://localhost:3000'

# Google Calendar OAuth application credentials. Create a Google Cloud Web
# application OAuth client and register this callback URI exactly:
#   https://YOUR_RCX_DOMAIN/api/integrations/google-calendar/oauth/callback
# Access/refresh tokens are tenant data and remain encrypted in integration_connections.
GOOGLE_OAUTH_CLIENT_ID=''
GOOGLE_OAUTH_CLIENT_SECRET=''
# Optional explicit callback override. Useful when AUTH_URL/request origin is not the
# public callback origin configured in Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=''

# Google RBM and SMS provider credentials are tenant/environment data, encrypted in
# provider_accounts. Do not put service-account JSON or Twilio auth tokens in env.

# Set to any truthy value to force the data layer to throw, for demoing error states (spec §27)
DEMO_FORCE_ERROR=''

# Demo workspace sign-in. Powers the one-click "Explore the demo workspace" button,
# and is what db/seed/auth.ts provisions. Omit both to disable demo access entirely.
DEMO_USER_EMAIL='demo@rcx.example'
DEMO_USER_PASSWORD=''

# RCX platform-admin bootstrap. These values are consumed only by
# `pnpm db:seed:admin`; they are not used to authorize requests at runtime.
# Use a unique production email and a password of at least 16 characters.
PLATFORM_ADMIN_EMAIL=''
PLATFORM_ADMIN_PASSWORD=''
PLATFORM_ADMIN_NAME='RCX Platform Admin'