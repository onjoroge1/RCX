# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (pooled endpoint)
DATABASE_URL='postgresql://user:password@host.neon.tech/dbname?sslmode=require'

# openssl rand -base64 32
AUTH_SECRET=''

# openssl rand -hex 32  — encrypts integration credentials and webhook signing secrets
ENCRYPTION_KEY=''

AUTH_URL='http://localhost:3000'

# Set to any truthy value to force the data layer to throw, for demoing error states (spec §27)
DEMO_FORCE_ERROR=''
